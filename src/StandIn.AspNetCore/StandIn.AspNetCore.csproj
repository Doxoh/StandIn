<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>StandIn.AspNetCore</PackageId>
    <Description>Simulate users during development (ASP.NET Core): cookie sign-in with a user picker, bearer tokens, token endpoint and configuration server. Successor of RimDev.Stuntman.</Description>
    <RootNamespace>StandIn.AspNetCore</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StandIn.AspNetCore.Tests" />
    <InternalsVisibleTo Include="StandIn.Testing" />
  </ItemGroup>

</Project>
