@using StandIn.AspNetCore
<!DOCTYPE html>
<html>
<head>
    <title>StandIn MVC sample - protected</title>
</head>
<body>
    <h1>Protected page</h1>
    <p>Signed in as: @User.Identity?.Name</p>
    <p>Roles: @string.Join(", ", User.Claims.Where(claim => claim.Type == "role").Select(claim => claim.Value))</p>
    @Html.StandInUserPicker()
</body>
</html>
